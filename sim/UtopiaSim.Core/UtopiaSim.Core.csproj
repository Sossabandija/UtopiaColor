<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Núcleo de la simulación. A propósito NO depende de Godot:
    el mismo código corre en la consola (UtopiaSim.Headless), en los tests
    y, más adelante, dentro del visor de Godot (Godot 4.6 .NET usa net8.0).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>UtopiaSim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UtopiaSim.Tests" />
  </ItemGroup>

</Project>
